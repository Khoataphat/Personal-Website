# ==============================================================================
# Environment Configuration Template (Vite + React)
# COPY THIS FILE TO .env OR .env.local AND FILL IN ACTUAL VALUES
# DO NOT COMMIT ACTUAL API KEYS OR SECRETS INTO VERSION CONTROL!
# ==============================================================================

# EmailJS Service Configuration (Public Client-side credentials)
VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# Application Base URL
VITE_APP_URL=https://your-domain.com

# Optional Backend API Base URL
VITE_API_BASE_URL=
